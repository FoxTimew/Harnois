# Include this file inside the http context (for example sites-enabled).
# No raw URI, query, IP, referer, cookie, body or user agent in access logs.
map $uri $harnois_route {
    default application;
    ~^/(api/auth|api/invitations|invitation|reset-password|verify-email)(/|$) authentication;
}
log_format harnois_safe '$time_iso8601 $request_method $status $body_bytes_sent $harnois_route';

server {
    listen 80;
    server_name @@HOST@@;
    access_log /var/log/nginx/harnois-access.log harnois_safe;
    # Nginx error logs may include the entire request URI, including bearer links.
    error_log /dev/null;
    return 308 https://@@HOST@@$request_uri;
}
server {
    listen 443 ssl;
    server_name @@HOST@@;
    ssl_certificate @@CERT@@;
    ssl_certificate_key @@KEY@@;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/harnois-access.log harnois_safe;
    error_log /dev/null;
    add_header Referrer-Policy no-referrer always;
    client_max_body_size 1m;
    location / {
        proxy_pass http://@@UPSTREAM@@;
        proxy_http_version 1.1;
        proxy_set_header Host @@HOST@@;
        proxy_set_header X-Forwarded-Host @@HOST@@;
        proxy_set_header X-Forwarded-Proto https;
        # Replace browser-supplied values; do not append an untrusted chain.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}
