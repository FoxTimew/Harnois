# Install after review as /etc/logrotate.d/harnois. Parent directory: root:root 0700.
/var/log/nginx/harnois/*.log {
    daily
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    create 0600 root root
    sharedscripts
    postrotate
        if [ -s /run/nginx.pid ]; then
            kill -USR1 "$(cat /run/nginx.pid)"
            # Workers cannot reopen through the root-only directory. New workers inherit the open file.
            /usr/sbin/nginx -t -q && kill -HUP "$(cat /run/nginx.pid)"
        fi
    endscript
}
