# Copier vers .env, puis renseigner les valeurs. Ne jamais commiter ce fichier local.
# PostgreSQL local : le port 5433 évite un conflit avec une autre instance sur 5432.
POSTGRES_USER=harnois
POSTGRES_PASSWORD=
POSTGRES_DB=harnois
POSTGRES_PORT=5433
# Adapter le mot de passe (encodé dans l'URL). En production, hôte db et port 5432.
DATABASE_URL=postgresql://harnois:REPLACE_ME@localhost:5433/harnois

# Secret aléatoire d'au moins 32 caractères. Génération : openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Obligatoirement 64 caractères hexadécimaux (32 octets) : openssl rand -hex 32
ENCRYPTION_KEY=
# Port publié par compose.prod.yml ; Next.js écoute sur 3000 dans le conteneur.
APP_PORT=3000

# Phase 01 : facultatif tant que le fournisseur n'est pas configuré.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# ID du tenant Microsoft, ou valeur appropriée à la politique d'authentification.
MICROSOFT_TENANT_ID=

# Brevo (phases ultérieures) : aucun appel externe en phase 00.
BREVO_API_KEY=
BREVO_EMAIL_FROM=
BREVO_EMAIL_FROM_NAME=Harnois
BREVO_SMS_SENDER=
# Transport email local, sans compte Brevo.
SMTP_HOST=localhost
SMTP_PORT=1025

# SeaweedFS local. Renseigner les deux clés (openssl rand -hex 16 / -hex 32).
# Ces noms restent identiques quel que soit le futur fournisseur S3.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=harnois-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
