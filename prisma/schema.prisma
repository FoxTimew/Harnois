// =====================================================================
//  Harnois : gestion de parc informatique
//  Schéma Prisma 7 / PostgreSQL
//
//  Conventions :
//   - Noms de modèles et de champs en anglais, commentaires en français.
//   - Montants en Decimal (jamais en Float) pour éviter les erreurs d'arrondi.
//   - On archive plutôt que de supprimer : les historiques (assignations,
//     licences, accès) sont conservés grâce aux champs returnedAt / revokedAt.
//     Les parents d\'un historique sont en onDelete: Restrict.
//   - Les emails sont toujours stockés en minuscules (normalisés par les services).
// =====================================================================

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"] // index partiels déclarés dans le schéma (Prisma >= 7.4)
}

datasource db {
  provider = "postgresql"
  // L'URL de connexion est définie dans prisma.config.ts (Prisma 7)
}

// ---------------------------------------------------------------------
//  ENUMS
// ---------------------------------------------------------------------

enum UserRole {
  ADMIN // accès total, gestion des utilisateurs
  IT_MANAGER // gestion du parc, finances, statistiques
  TECHNICIAN // tickets, assignations, checklists
  EMPLOYEE // crée ses tickets, voit son matériel
}

enum EmployeeStatus {
  ONBOARDING
  ACTIVE
  OFFBOARDING
  LEFT
}

enum EquipmentStatus {
  IN_STOCK
  ASSIGNED
  LOANED // prêt temporaire
  IN_REPAIR
  LOST
  RETIRED // réformé / recyclé
}

enum EquipmentCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
}

enum BillingCycle {
  MONTHLY
  YEARLY
  ONE_TIME // licence perpétuelle, achat unique
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLED
  EXPIRED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

enum TicketType {
  INCIDENT // quelque chose ne marche pas
  REQUEST // demande de matériel / d'accès
  QUESTION
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING // en attente de l'utilisateur ou d'un fournisseur
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ChecklistType {
  ONBOARDING
  OFFBOARDING
  OTHER
}

enum ChecklistStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum MfaMethod {
  TOTP // application d'authentification (Google Authenticator, Authy, 1Password...)
  WEBAUTHN // clé de sécurité : YubiKey, passkey du téléphone (QR code), Windows Hello, Touch ID
  RECOVERY_CODE // code de secours à usage unique
}

// ---------------------------------------------------------------------
//  AUTHENTIFICATION & RÔLES
//
//  Connexion principale (Better Auth) : Google, Microsoft ou email + mot de passe.
//  Tables imposées par Better Auth : User, Session, Account, Verification.
//
//  Double authentification (couche maison, appliquée APRÈS n'importe quelle
//  connexion principale, y compris Google/Microsoft) :
//    - TotpFactor          : code à 6 chiffres
//    - WebAuthnCredential  : clé de sécurité / passkey
//    - RecoveryCode        : codes de secours
//  Session.mfaVerifiedAt reste NULL tant que le 2e facteur n'est pas validé :
//  le middleware bloque alors l'accès à l'application.
//
//  User = personne qui se connecte. Employee = membre du personnel
//  (peut ne jamais se connecter). Relation 1-1 optionnelle.
// ---------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique // email de connexion (pro ou perso)
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(EMPLOYEE)
  isActive      Boolean   @default(true)
  mfaEnforced   Boolean   @default(false) // force le 2FA pour cet utilisateur, quel que soit son rôle
  lastLoginAt   DateTime?
  employeeId    String?   @unique
  employee      Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  // Authentification
  sessions            Session[]
  accounts            Account[]
  totpFactor          TotpFactor?
  webauthnCredentials WebAuthnCredential[]
  recoveryCodes       RecoveryCode[]
  invitationsSent     Invitation[]         @relation("InvitedBy")

  // Métier
  assignmentsMade    EquipmentAssignment[]
  ticketsAssigned    Ticket[]              @relation("TicketAssignee")
  ticketComments     TicketComment[]
  checklistsCreated  Checklist[]
  checklistItemsDone ChecklistItem[]
  attachments        Attachment[]
  notifications      Notification[]
  auditLogs          AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id            String     @id @default(cuid())
  token         String     @unique
  expiresAt     DateTime
  ipAddress     String?
  userAgent     String?
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaVerifiedAt DateTime? // NULL = 2e facteur pas encore validé pour cette session
  mfaMethod     MfaMethod?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Méthode de connexion liée à un utilisateur (Better Auth) :
// providerId = "google" | "microsoft" | "credential" (email + mot de passe haché)
model Account {
  id                    String    @id @default(cuid())
  accountId             String // identifiant chez le fournisseur
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // hash, uniquement pour providerId = "credential"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

// Jetons temporaires (Better Auth) : vérification d'email, réinitialisation
// de mot de passe. Sert aussi à stocker les challenges WebAuthn.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}

// Inscription sur invitation uniquement : impossible de créer un compte
// avec une adresse qui n'a pas été invitée par un administrateur.
model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        UserRole  @default(EMPLOYEE)
  employeeId  String? // employé à lier automatiquement au compte créé
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById String?
  invitedBy   User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // Une seule invitation en attente par adresse. Une invitation expirée doit être
  // révoquée (revokedAt) par le service avant d\'en créer une nouvelle.
  @@unique([email], where: { acceptedAt: null, revokedAt: null }, map: "Invitation_pending_email_key")
  @@index([email])
}

// Un seul authentificateur TOTP par utilisateur
model TotpFactor {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted String // secret chiffré en AES-256-GCM (clé dans une variable d'environnement)
  confirmedAt     DateTime? // NULL tant que l'utilisateur n'a pas saisi un 1er code valide
  lastUsedStep    Int? // dernière fenêtre de 30 s utilisée : empêche de rejouer un code
  lastUsedAt      DateTime?

  createdAt DateTime @default(now())
}

// Clés de sécurité et passkeys. Plusieurs par utilisateur (ex : une YubiKey
// principale + une de secours, ou une YubiKey + le téléphone).
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String // nom donné par l'utilisateur : "YubiKey 5C", "iPhone de Marie"
  credentialId String    @unique // base64url
  publicKey    Bytes
  counter      BigInt    @default(0) // compteur de signatures (détection de clé clonée)
  transports   String[] // usb, nfc, ble, hybrid (QR code), internal
  deviceType   String // singleDevice (clé physique) | multiDevice (passkey synchronisée)
  backedUp     Boolean   @default(false)
  aaguid       String? // identifie le modèle d'authentificateur
  lastUsedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

// 10 codes de secours, stockés hachés, utilisables une seule fois
model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------
//  ORGANISATION
// ---------------------------------------------------------------------

model Organization {
  id   String @id @default(cuid())
  name String @unique

  departments   Department[]
  employees     Employee[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pôle / service, rattaché à une organisation
model Department {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
}

// Site / bureau physique
model Location {
  id      String  @id @default(cuid())
  name    String  @unique
  address String?
  city    String?

  employees  Employee[]
  equipments Equipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------
//  EMPLOYÉS
// ---------------------------------------------------------------------

model Employee {
  id        String         @id @default(cuid())
  firstName String
  lastName  String
  email     String         @unique
  phone     String? // format E.164 (+33...) pour les SMS
  jobTitle  String? // poste
  status    EmployeeStatus @default(ONBOARDING)
  startDate DateTime?      @db.Date
  endDate   DateTime?      @db.Date

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  locationId     String?
  location       Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)

  // Auto-relation : responsable hiérarchique (utile pour valider les demandes)
  managerId String?
  manager   Employee?  @relation("Management", fields: [managerId], references: [id], onDelete: SetNull)
  reports   Employee[] @relation("Management")

  user                 User?
  invitations          Invitation[]
  equipmentAssignments EquipmentAssignment[]
  licenses             License[]
  accountAccesses      AccountAccess[]
  ticketsRequested     Ticket[]              @relation("TicketRequester")
  checklists           Checklist[]
  notifications        Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([departmentId])
  @@index([status])
  @@index([lastName, firstName])
}

// ---------------------------------------------------------------------
//  ÉQUIPEMENTS
// ---------------------------------------------------------------------

// Catégories hiérarchiques : "Informatique" > "PC portable", "Mobilier" > "Bureau"
model Category {
  id       String     @id @default(cuid())
  name     String     @unique
  icon     String?
  parentId String?
  parent   Category?  @relation("Subcategories", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("Subcategories")

  equipments Equipment[]
}

model Supplier {
  id      String  @id @default(cuid())
  name    String  @unique
  email   String?
  phone   String?
  website String?
  notes   String?

  equipments Equipment[]
  software   Software[]
  invoices   Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Equipment {
  id                 String             @id @default(cuid())
  assetTag           String             @unique // n° d'inventaire interne, encodé dans le QR code
  name               String
  brand              String?
  model              String?
  serialNumber       String?            @unique
  status             EquipmentStatus    @default(IN_STOCK)
  condition          EquipmentCondition @default(NEW)
  purchasePrice      Decimal?           @db.Decimal(10, 2) // HT
  purchaseDate       DateTime?          @db.Date
  warrantyEndDate    DateTime?          @db.Date
  depreciationMonths Int? // durée d'amortissement (ex : 36)
  specs              Json? // CPU, RAM, OS, taille d'écran... (varie selon la catégorie)
  notes              String?

  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  assignments EquipmentAssignment[]
  invoices    Invoice[] // Many-to-Many implicite
  tickets     Ticket[]
  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([warrantyEndDate])
}

// Historique d'assignation : remplace le simple employeeId sur Equipment.
// Assignation active = returnedAt IS NULL (unicité garantie par un index partiel SQL).
model EquipmentAssignment {
  id           String              @id @default(cuid())
  equipmentId  String
  equipment    Equipment           @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  employeeId   String
  employee     Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignedAt   DateTime            @default(now())
  returnedAt   DateTime?
  conditionOut EquipmentCondition? // état à la remise
  conditionIn  EquipmentCondition? // état au retour
  notes        String?
  assignedById String?
  assignedBy   User?               @relation(fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([equipmentId], where: { returnedAt: null }, map: "EquipmentAssignment_active_equipment_key")
  @@index([equipmentId, returnedAt])
  @@index([employeeId, returnedAt])
}

// ---------------------------------------------------------------------
//  LOGICIELS, PLANS, ABONNEMENTS, LICENCES
//  Software (Microsoft 365)
//    └─ SoftwarePlan (Business Standard : offre catalogue)
//         └─ Subscription (ce qu'on a réellement acheté : 25 sièges à 10,50 €)
//              └─ License (un siège attribué à un employé, avec historique)
// ---------------------------------------------------------------------

model Software {
  id          String    @id @default(cuid())
  name        String    @unique
  vendor      String? // éditeur
  category    String? // bureautique, design, gestion de projet...
  website     String?
  logoUrl     String?
  description String?
  supplierId  String? // revendeur, si différent de l'éditeur
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  plans    SoftwarePlan[]
  accounts SoftwareAccount[]
  tickets  Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SoftwarePlan {
  id           String       @id @default(cuid())
  name         String
  softwareId   String
  software     Software     @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  billingCycle BillingCycle @default(MONTHLY)
  listPrice    Decimal?     @db.Decimal(10, 2) // prix catalogue par siège et par cycle
  currency     String       @default("EUR")

  subscriptions Subscription[]

  @@unique([softwareId, name])
}

model Subscription {
  id             String             @id @default(cuid())
  planId         String
  plan           SoftwarePlan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  organizationId String? // pour ventiler les coûts par organisation
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  seats          Int                @default(1) // licences achetées
  unitPrice      Decimal            @db.Decimal(10, 2) // prix réel (négocié) par siège et par cycle
  billingCycle   BillingCycle       @default(MONTHLY)
  currency       String             @default("EUR")
  status         SubscriptionStatus @default(ACTIVE)
  startDate      DateTime           @db.Date
  renewalDate    DateTime?          @db.Date // déclenche les alertes de renouvellement
  endDate        DateTime?          @db.Date
  autoRenew      Boolean            @default(true)
  contractRef    String?
  notes          String?

  licenses License[]
  invoices Invoice[] // Many-to-Many implicite

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([status])
  @@index([renewalDate])
}

// Licences disponibles = Subscription.seats - nombre de License où revokedAt IS NULL
model License {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  licenseKey     String? // chiffrée côté application avant stockage
  assignedAt     DateTime     @default(now())
  revokedAt      DateTime?

  @@unique([subscriptionId, employeeId], where: { revokedAt: null }, map: "License_active_subscription_employee_key")
  @@index([subscriptionId, revokedAt])
  @@index([employeeId, revokedAt])
}

// ---------------------------------------------------------------------
//  COMPTES & ACCÈS
//  Un compte appartient à un logiciel. Il peut être personnel ou partagé
//  (ex : compte LinkedIn de l'entreprise), d'où le Many-to-Many explicite
//  via AccountAccess. AUCUN mot de passe n'est stocké ici.
// ---------------------------------------------------------------------

model SoftwareAccount {
  id             String        @id @default(cuid())
  identifier     String // login ou email utilisé sur la plateforme
  softwareId     String
  software       Software      @relation(fields: [softwareId], references: [id], onDelete: Restrict)
  isShared       Boolean       @default(false)
  status         AccountStatus @default(ACTIVE)
  mfaEnabled     Boolean       @default(false)
  url            String?
  notes          String?
  lastReviewedAt DateTime? // dernière revue des accès

  accesses AccountAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([softwareId, identifier])
}

model AccountAccess {
  id         String          @id @default(cuid())
  accountId  String
  account    SoftwareAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  employeeId String
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  role       String? // admin, éditeur, lecteur...
  grantedAt  DateTime        @default(now())
  revokedAt  DateTime?

  @@unique([accountId, employeeId], where: { revokedAt: null }, map: "AccountAccess_active_account_employee_key")
  @@index([accountId, revokedAt])
  @@index([employeeId, revokedAt])
}

// ---------------------------------------------------------------------
//  FINANCES
// ---------------------------------------------------------------------

// Une facture peut couvrir plusieurs équipements et/ou plusieurs abonnements
model Invoice {
  id            String        @id @default(cuid())
  number        String
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  issueDate     DateTime      @db.Date
  dueDate       DateTime?     @db.Date
  amountExclTax Decimal       @db.Decimal(12, 2) // HT
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  amountInclTax Decimal       @db.Decimal(12, 2) // TTC
  currency      String        @default("EUR")
  status        InvoiceStatus @default(PENDING)
  paidAt        DateTime?
  externalUrl   String? // lien vers la facture (portail fournisseur...)
  notes         String?

  equipments    Equipment[]
  subscriptions Subscription[]
  attachments   Attachment[] // fichiers PDF

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierId, number])
  @@index([issueDate])
}

// Fichiers stockés sur S3 / MinIO : factures, photos de matériel, captures de tickets
model Attachment {
  id         String @id @default(cuid())
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String @unique // chemin dans le bucket

  invoiceId    String?
  invoice      Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  ticketId     String?
  ticket       Ticket?    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  equipmentId  String?
  equipment    Equipment? @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([ticketId])
  @@index([equipmentId])
}

// ---------------------------------------------------------------------
//  TICKETING
// ---------------------------------------------------------------------

model Ticket {
  id          String         @id @default(cuid())
  number      Int            @unique @default(autoincrement()) // n° lisible : #1042
  title       String
  description String
  type        TicketType     @default(INCIDENT)
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)

  requesterId String
  requester   Employee   @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assigneeId  String?
  assignee    User?      @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  equipmentId String? // matériel concerné
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  softwareId  String? // logiciel concerné
  software    Software?  @relation(fields: [softwareId], references: [id], onDelete: SetNull)

  dueAt      DateTime?
  resolvedAt DateTime?
  closedAt   DateTime?

  comments    TicketComment[]
  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, priority])
  @@index([requesterId])
  @@index([assigneeId])
}

model TicketComment {
  id         String  @id @default(cuid())
  ticketId   String
  ticket     Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  isInternal Boolean @default(false) // note visible uniquement par l'équipe IT

  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ---------------------------------------------------------------------
//  CHECKLISTS (arrivée / départ)
//  Modèle réutilisable -> instance copiée pour un employé donné.
//  La copie des items permet de modifier un modèle sans casser
//  les checklists déjà en cours.
// ---------------------------------------------------------------------

model ChecklistTemplate {
  id          String        @id @default(cuid())
  name        String        @unique
  type        ChecklistType
  description String?
  isActive    Boolean       @default(true)

  items      ChecklistTemplateItem[]
  checklists Checklist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChecklistTemplateItem {
  id                  String            @id @default(cuid())
  templateId          String
  template            ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label               String
  description         String?
  position            Int
  isRequired          Boolean           @default(true)
  dueOffsetDays       Int? // ex : -7 = une semaine avant la date d'arrivée/départ
  defaultAssigneeRole UserRole?

  @@index([templateId, position])
}

model Checklist {
  id          String             @id @default(cuid())
  title       String
  type        ChecklistType
  status      ChecklistStatus    @default(PENDING)
  templateId  String?
  template    ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  employeeId  String // personne qui arrive / part
  employee    Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdById String?
  createdBy   User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  dueDate     DateTime?          @db.Date
  completedAt DateTime?

  items ChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  label       String
  description String?
  position    Int
  isRequired  Boolean   @default(true)
  dueDate     DateTime? @db.Date
  isDone      Boolean   @default(false)
  doneAt      DateTime?
  doneById    String?
  doneBy      User?     @relation(fields: [doneById], references: [id], onDelete: SetNull)
  comment     String?

  @@index([checklistId, position])
}

// ---------------------------------------------------------------------
//  NOTIFICATIONS
//  Sert de file d'attente : un worker envoie les PENDING dont
//  scheduledAt est passé (relances, alertes de renouvellement...).
// ---------------------------------------------------------------------

model Notification {
  id          String              @id @default(cuid())
  channel     NotificationChannel
  status      NotificationStatus  @default(PENDING)
  recipient   String? // email ou téléphone (EMAIL / SMS)
  userId      String? // destinataire in-app
  user        User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId  String?
  employee    Employee?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  subject     String?
  body        String
  event       String? // ex : SUBSCRIPTION_RENEWAL, TICKET_UPDATED, WARRANTY_EXPIRING
  entityType  String? // ex : "Ticket"
  entityId    String?
  readAt      DateTime? // pour les notifications in-app
  scheduledAt DateTime            @default(now())
  sentAt      DateTime?
  attempts    Int                 @default(0)
  error       String?

  createdAt DateTime @default(now())

  @@index([status, scheduledAt])
  @@index([userId, readAt])
}

// ---------------------------------------------------------------------
//  JOURNAL D'AUDIT : qui a fait quoi, quand
// ---------------------------------------------------------------------

model AuditLog {
  id         String  @id @default(cuid())
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // CREATE, UPDATE, DELETE, ASSIGN, REVOKE...
  entityType String // "Equipment", "License"...
  entityId   String
  changes    Json? // { avant, après }
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}
